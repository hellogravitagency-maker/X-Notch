<UserControl x:Class="XNotch.Views.TasksWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="128"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
                <ResourceDictionary Source="Components/RoundedScrollBarStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid VerticalAlignment="Stretch" Margin="6,0" Background="Transparent" PreviewMouseWheel="OnPreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Row -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderIconText" Text="✓" FontSize="11" FontWeight="Bold" Foreground="#30D158" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderTitleText" Text="TASKS &amp; FOCUS" FontSize="9.5" FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <Border x:Name="PendingBadge" Background="#2530D158" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PendingCountText" Text="0 pending" FontSize="9.5" FontWeight="Bold" Foreground="#30D158"/>
                </Border>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Auto-Task Mode Toggle Button with Icon -->
                <Button x:Name="AutoTasksToggleButton"
                        Style="{StaticResource IconButton}"
                        Height="20" Padding="6,1" Margin="0,0,4,0"
                        Click="OnAutoTasksToggleClick"
                        ToolTip="Toggle between My Tasks and Discovered Auto-Tasks">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AutoTaskIcon" Text="⚡" FontSize="9.5" FontWeight="Bold" Foreground="#FF9F0A" Margin="0,0,3,0"/>
                        <TextBlock x:Name="AutoTaskLabel" Text="Auto-Tasks" FontSize="9" FontWeight="Bold" Foreground="#FF9F0A"/>
                        <Border x:Name="AutoTaskCountBadge" Background="#30FF9F0A" CornerRadius="4" Padding="4,0" Margin="4,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="AutoTaskCountText" Text="0" FontSize="8.5" FontWeight="Bold" Foreground="#FF9F0A"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button x:Name="ClearCompletedButton"
                        Style="{StaticResource IconButton}"
                        Height="20" Padding="6,1"
                        Click="OnClearCompletedClick"
                        ToolTip="Clear completed tasks">
                    <TextBlock Text="Clear Done" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Inline Quick Add Input with Apple Hairline Border -->
        <Border x:Name="InputContainerBorder" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="8,2" Margin="0,0,0,5" Cursor="IBeam"
                MouseLeftButtonDown="OnInputContainerMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewTaskInput"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="#30D158"
                         FontSize="11"
                         VerticalAlignment="Center"
                         Focusable="True"
                         IsTabStop="True"
                         Cursor="IBeam"
                         PreviewMouseLeftButtonDown="OnNewTaskInputMouseDown"
                         KeyDown="OnNewTaskKeyDown"/>
                <TextBlock x:Name="InputPlaceholder"
                           Grid.Column="0"
                           Text="+ Add a new task (Press Enter)..."
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextFaintBrush}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"/>
                <Button x:Name="AddTaskButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Width="22" Height="22"
                        Click="OnAddTaskClick"
                        ToolTip="Add task (Enter)">
                    <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#30D158"/>
                </Button>
            </Grid>
        </Border>

        <!-- Tasks Items Scroll List -->
        <ScrollViewer x:Name="TasksScrollViewer"
                      Grid.Row="2"
                      VerticalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly"
                      Background="Transparent"
                      Style="{StaticResource RoundedScrollViewer}">
            <StackPanel x:Name="TasksListPanel">
                <TextBlock x:Name="NoTasksPlaceholder"
                           Text="No active tasks. Type above to add one!"
                           FontSize="10" FontStyle="Italic"
                           Foreground="{DynamicResource TextFaintestBrush}"
                           Margin="2,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
