<UserControl x:Class="XNotch.Views.InlineSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/ToggleSwitchStyle.xaml"/>
                <ResourceDictionary Source="Components/RoundedScrollBarStyle.xaml"/>
                <ResourceDictionary Source="Components/SliderStyle.xaml"/>
                <ResourceDictionary Source="Components/SegmentedRadioStyle.xaml"/>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

                        <Style x:Key="ColorSwatchButton" TargetType="Button">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="0,0,6,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SwatchBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="11"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SwatchScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2.2"/>
                                    <Setter TargetName="SwatchBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.18" ScaleY="1.18"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PresetThemeButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,5,5"/>
                <Setter Property="Padding" Value="7,3.5"/>
                <Setter Property="Background" Value="{DynamicResource SegmentedBgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PresetBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PresetBorder" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,8,0,4"/>
            </Style>
            <Style x:Key="SettingLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SettingLabelBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid PreviewMouseWheel="OnSettingsPreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: back arrow + "Settings" title -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Click="OnBackClick"
                        Style="{StaticResource IconButton}"
                        Width="24" Height="24"
                        VerticalAlignment="Center" ToolTip="Back">
                    <TextBlock Text="←" FontSize="14" Foreground="{DynamicResource TextMutedBrush}"/>
                </Button>
                <TextBlock Text="Settings" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Scrollable settings in a compact two-column layout -->
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="Transparent"
                      PanningMode="VerticalOnly"
                      Focusable="False"
                      PreviewMouseWheel="OnSettingsPreviewMouseWheel"
                      Style="{StaticResource RoundedScrollViewer}">
            <StackPanel Margin="2,0,6,14">

                <!-- General -->
                <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Start on boot" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="StartOnBootCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Auto hide when idle" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="AutoHideCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Tucks notch into top edge sliver when idle; springs out instantly when mouse approaches screen edge."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Pop-up centered at cursor" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="CursorCenterPlacementCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Summons island directly centered around mouse cursor position (Ctrl+Alt+N or tray action)."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Pop-up when under camera" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="CameraHoverPopUpCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Briefly pops up the notch for 1-2 seconds when cursor is placed directly under the camera."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <!-- Hover mode -->
                <TextBlock Text="Hover behavior" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" Margin="0,4,0,2"/>
                <Border Background="{DynamicResource SegmentedBgBrush}" CornerRadius="10" Padding="2" Height="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="HoverPeekRadio" Content="Peek + Click"
                                     Grid.Column="0" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnHoverModeChanged"/>
                        <RadioButton x:Name="LongHoverRadio" Content="Long hover"
                                     Grid.Column="1" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnHoverModeChanged"/>
                    </Grid>
                </Border>

                <!-- Appearance -->
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>

                <!-- Theme selector (Dark, Light, White, Glass, Custom) -->
                <TextBlock Text="Theme" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" Margin="0,4,0,2"/>
                <Border Background="{DynamicResource SegmentedBgBrush}" CornerRadius="10" Padding="2" Height="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="ThemeDarkRadio" Content="Dark"
                                     Grid.Column="0" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeLightRadio" Content="Light"
                                     Grid.Column="1" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeWhiteRadio" Content="White"
                                     Grid.Column="2" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeGlassRadio" Content="Glass"
                                     Grid.Column="3" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnThemeChanged" ToolTip="Liquid Glass (Frosted Acrylic)"/>
                        <RadioButton x:Name="ThemeCustomRadio" Content="Custom"
                                     Grid.Column="4" Style="{StaticResource SegmentedRadio}"
                                     Checked="OnThemeChanged"/>
                    </Grid>
                </Border>

                <!-- Custom Theme Color Changer Section -->
                <TextBlock Text="THEME COLOR CHANGER" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Accent highlight color:" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" Margin="0,2,0,3"/>

                <!-- Accent Color Swatches -->
                <WrapPanel Margin="0,0,0,4">
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#007AFF" Tag="#007AFF" Click="OnAccentColorPresetClick" ToolTip="Electric Blue"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnAccentColorPresetClick" ToolTip="Neon Violet"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#10B981" Tag="#10B981" Click="OnAccentColorPresetClick" ToolTip="Emerald Mint"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#F97316" Tag="#F97316" Click="OnAccentColorPresetClick" ToolTip="Sunset Orange"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#EF4444" Tag="#EF4444" Click="OnAccentColorPresetClick" ToolTip="Crimson Red"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#EC4899" Tag="#EC4899" Click="OnAccentColorPresetClick" ToolTip="Rose Pink"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#F59E0B" Tag="#F59E0B" Click="OnAccentColorPresetClick" ToolTip="Solar Gold"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#06B6D4" Tag="#06B6D4" Click="OnAccentColorPresetClick" ToolTip="Cyber Cyan"/>
                    <Button Style="{StaticResource ColorSwatchButton}" Background="#64748B" Tag="#64748B" Click="OnAccentColorPresetClick" ToolTip="Slate Monochrome"/>
                </WrapPanel>

                <!-- Accent Color Hex Input Row -->
                <Grid Height="28" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="AccentPreviewBox" Width="20" Height="20" CornerRadius="4"
                            Background="#007AFF" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="AccentHexInput" Grid.Column="1" Text="#007AFF" FontSize="11"
                             VerticalContentAlignment="Center" Padding="6,2" Height="26"
                             Background="{DynamicResource SegmentedBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                             TextChanged="OnAccentHexChanged"/>
                </Grid>

                <!-- Custom Notch Background Panel (Active in Custom Mode) -->
                <StackPanel x:Name="CustomThemeSettingsPanel" Visibility="Collapsed" Margin="0,0,0,4">
                    <TextBlock Text="Notch background color:" Foreground="{DynamicResource TextSubtleBrush}" FontSize="10" Margin="0,4,0,3"/>
                    <WrapPanel Margin="0,0,0,4">
                        <Button Style="{StaticResource ColorSwatchButton}" Background="#0F172A" Tag="#0F172A" Click="OnBgColorPresetClick" ToolTip="Midnight Navy"/>
                        <Button Style="{StaticResource ColorSwatchButton}" Background="#180D2B" Tag="#180D2B" Click="OnBgColorPresetClick" ToolTip="Cyber Purple"/>
                        <Button Style="{StaticResource ColorSwatchButton}" Background="#0A1F14" Tag="#0A1F14" Click="OnBgColorPresetClick" ToolTip="Deep Forest"/>
                        <Button Style="{StaticResource ColorSwatchButton}" Background="#250914" Tag="#250914" Click="OnBgColorPresetClick" ToolTip="Velvet Wine"/>
                        <Button Style="{StaticResource ColorSwatchButton}" Background="#000000" Tag="#000000" Click="OnBgColorPresetClick" ToolTip="Obsidian Black"/>
                        <Button Style="{StaticResource ColorSwatchButton}" Background="#1E293B" Tag="#1E293B" Click="OnBgColorPresetClick" ToolTip="Slate Gray"/>
                        <Button Style="{StaticResource ColorSwatchButton}" Background="#FFFFFF" Tag="#FFFFFF" Click="OnBgColorPresetClick" ToolTip="Pure Snow"/>
                        <Button Style="{StaticResource ColorSwatchButton}" Background="#F8F6F0" Tag="#F8F6F0" Click="OnBgColorPresetClick" ToolTip="Warm Ivory"/>
                    </WrapPanel>

                    <!-- Background Hex Input Row -->
                    <Grid Height="28" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BgPreviewBox" Width="20" Height="20" CornerRadius="4"
                                Background="#0F172A" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="BgHexInput" Grid.Column="1" Text="#0F172A" FontSize="11"
                                 VerticalContentAlignment="Center" Padding="6,2" Height="26"
                                 Background="{DynamicResource SegmentedBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                 TextChanged="OnBgHexChanged"/>
                    </Grid>
                </StackPanel>

                <!-- One-click Custom Theme Presets -->
                <TextBlock Text="Instant theme presets:" Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,2,0,3"/>
                <WrapPanel Margin="0,0,0,6">
                    <Button Style="{StaticResource PresetThemeButton}" Content="🌌 Cyberpunk" Tag="Cyberpunk" Click="OnQuickPresetClick"/>
                    <Button Style="{StaticResource PresetThemeButton}" Content="❄️ Pure Snow" Tag="PureSnow" Click="OnQuickPresetClick"/>
                    <Button Style="{StaticResource PresetThemeButton}" Content="🌲 Emerald" Tag="Emerald" Click="OnQuickPresetClick"/>
                    <Button Style="{StaticResource PresetThemeButton}" Content="🍷 Velvet" Tag="Velvet" Click="OnQuickPresetClick"/>
                    <Button Style="{StaticResource PresetThemeButton}" Content="☀️ Amber" Tag="Amber" Click="OnQuickPresetClick"/>
                </WrapPanel>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Adapt to Windows theme" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="AdaptToWindowsThemeCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnAdaptThemeChanged" Unchecked="OnAdaptThemeChanged"/>
                </Grid>
                <TextBlock Text="Follows Windows light or dark mode, accent color, and accessibility-friendly contrast live."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Show shadow" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowShadowCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- Music -->
                <TextBlock Text="MUSIC" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Music controls" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowMusicCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Audio visualizer" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowVisualizerCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- System HUD -->
                <TextBlock Text="SYSTEM HUD" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Volume HUD" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="VolumeHudCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Brightness HUD" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="BrightnessHudCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- Battery & Calendar -->
                <TextBlock Text="WIDGETS &amp; CARDS" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Music player card" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowMusicCardCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Time stopper (Stopwatch)" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowStopwatchCardCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Water tracking (Hydration)" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowWaterCardCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Sleep tracking &amp; schedule" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowSleepCardCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Tasks &amp; To-Do focus" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowTasksCardCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="System vitals &amp; telemetry" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowVitalsCardCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Notification history &amp; alerts" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowNotificationsCardCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Battery indicator" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowBatteryCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Calendar panel" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowCalendarCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Webcam mirror" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowWebcamCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Height="28" Margin="0,2" x:Name="WebcamFpsPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mirror FPS" Style="{StaticResource SettingLabel}" Grid.Column="0"/>
                    <Slider x:Name="WebcamFpsSlider" Grid.Column="1"
                            Style="{StaticResource CompactSlider}"
                            Minimum="5" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1"
                            VerticalAlignment="Center" Margin="10,0,10,0"
                            ValueChanged="OnWebcamFpsChanged"/>
                    <Border Grid.Column="2" Background="{DynamicResource SegmentedBgBrush}"
                            CornerRadius="6" Padding="6,2" MinWidth="32">
                        <TextBlock x:Name="WebcamFpsLabel"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Screens -->
                <TextBlock Text="SCREENS" Style="{StaticResource SectionHeader}"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Reserve space at top" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ReserveSpaceCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Claims a dedicated strip at the top of the screen (like the taskbar) so maximized windows start below the notch. Fullscreen apps still cover it."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Island on every screen" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowOnAllScreensCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Shows an island on each connected display. Drag any island to move it between screens."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <Grid Height="28" Margin="0,2">
                    <TextBlock Text="Synchronize islands" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="SyncIslandsCheck" Style="{StaticResource ToggleSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>
                <TextBlock Text="Opening or closing one island does the same on all screens. Off = each island acts independently."
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>



                <!-- Developer & Workspaces -->
                <TextBlock Text="DEVELOPER &amp; WORKSPACES" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Workspace scan roots for coding agents &amp; git projects:"
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>

                <ItemsControl x:Name="WorkspaceRootsList" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="20" Height="20"
                                        Tag="{Binding}" Click="OnRemoveWorkspaceRootClick" ToolTip="Remove folder">
                                    <TextBlock Text="✕" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="AddWorkspaceRootButton" Click="OnAddWorkspaceRootClick"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋ " Foreground="{DynamicResource TextSubtleBrush}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Add workspace folder..." Foreground="{DynamicResource TextSubtleBrush}" FontSize="11" TextDecorations="Underline"/>
                    </StackPanel>
                </Button>

                <!-- Plugins -->
                <TextBlock Text="PLUGINS" Style="{StaticResource SectionHeader}"/>

                <Button x:Name="ManagePluginsButton" Click="OnManagePluginsClick"
                        HorizontalAlignment="Left" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,4">
                    <TextBlock Text="Manage plugins"
                               Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                               TextDecorations="Underline"/>
                </Button>

                <!-- About -->
                <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,6">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#141416" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/X-Notch;component/Assets/Icons/XNotch.png" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11" Text="X-Notch"/>
                        <TextBlock Foreground="{DynamicResource TextFaintBrush}" FontSize="9" Text="© Gravit • Dynamic Island for Windows"/>
                    </StackPanel>
                </StackPanel>

                <!-- Update check -->
                <Grid Margin="0,0,0,8">
                    <Button x:Name="CheckUpdateButton" Click="OnCheckUpdateClick"
                            HorizontalAlignment="Left" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Padding="0">
                        <TextBlock x:Name="CheckUpdateText" Text="Check for updates"
                                   Foreground="{DynamicResource TextSubtleBrush}" FontSize="10"
                                   TextDecorations="Underline"/>
                    </Button>
                    <Button x:Name="UpdateButton" Click="OnUpdateClick"
                            Visibility="Collapsed" HorizontalAlignment="Left"
                            Cursor="Hand" Padding="6,3" Background="{DynamicResource SegmentedCheckedBgBrush}"
                            BorderThickness="0">
                        <TextBlock x:Name="UpdateButtonText" Text="Update available"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontWeight="SemiBold"/>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
