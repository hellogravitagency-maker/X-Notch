<UserControl x:Class="XNotch.Views.HudOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">

    <!-- Apple Dynamic Island liquid HUD capsule for Volume & Brightness adjustments -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,8,0"
          RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="HudScale" ScaleX="1.0" ScaleY="1.0"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Glyphs with crisp iOS appearance & vibrant state badge -->
        <Border Grid.Column="0"
                x:Name="HudIconBorder"
                Width="22" Height="22"
                CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Margin="0,0,10,0"
                VerticalAlignment="Center">
            <TextBlock x:Name="HudIcon"
                       Text="🔊"
                       FontSize="11.5"
                       Foreground="{DynamicResource HudIconBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- iOS 6px thick liquid slider track -->
        <Border Grid.Column="1"
                Height="6"
                CornerRadius="3"
                Background="{DynamicResource ProgressTrackBrush}"
                VerticalAlignment="Center"
                Cursor="Hand"
                ClipToBounds="True"
                MouseLeftButtonDown="OnSliderClick">
            <Border x:Name="SliderFill"
                    Height="6"
                    CornerRadius="3"
                    Background="{DynamicResource HudSliderFillBrush}"
                    HorizontalAlignment="Left"/>
        </Border>

        <!-- Percentage with tabular figures -->
        <TextBlock x:Name="HudPercent"
                   Grid.Column="2"
                   Text="50%"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="10.5"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"
                   MinWidth="36"
                   TextAlignment="Right"
                   Typography.NumeralAlignment="Tabular"/>
    </Grid>
</UserControl>
