<UserControl x:Class="XNotch.Views.AgentsWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:XNotch.Helpers"
             Height="128"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/RoundedScrollBarStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="6,0" Background="Transparent" PreviewMouseWheel="OnPreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{l:L 'AGENTS'}" FontSize="9.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
            <Border Background="#250A84FF" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Text="{l:L '0 active'}" FontSize="9.5" FontWeight="Bold" Foreground="#0A84FF"/>
            </Border>
        </StackPanel>

        <ScrollViewer x:Name="ListScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource RoundedScrollViewer}">
            <StackPanel x:Name="ListPanel"/>
        </ScrollViewer>

        <Border x:Name="EmptyState" Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="10" Padding="12,14" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="EmptyTitle" Text="{l:L 'No agents running'}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="EmptyHint" Text="{l:L 'Start Claude Code or Codex and it shows up here'}"
                           FontSize="10" Margin="0,3,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
