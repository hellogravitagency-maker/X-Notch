<UserControl x:Class="XNotch.Views.BatteryIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Apple iOS authentic battery indicator for Dynamic Island -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
        <!-- Battery icon capsule -->
        <Grid Width="20" Height="10.5" VerticalAlignment="Center">
            <!-- Battery body with continuous squircle border -->
            <Border BorderBrush="{DynamicResource BatteryBorderBrush}"
                    BorderThickness="1.2" CornerRadius="2.8"
                    Margin="0,0,2.5,0">
                <Grid>
                    <Border x:Name="BatteryFill"
                            Background="{DynamicResource SuccessBrush}"
                            CornerRadius="1.2"
                            Margin="1"
                            HorizontalAlignment="Left"/>
                    <!-- Charging Bolt Glyph -->
                    <TextBlock x:Name="BoltIcon" Text="⚡"
                               FontSize="7" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" Margin="0,-0.5,0,0"/>
                </Grid>
            </Border>
            <!-- Battery terminal nipple -->
            <Border Width="1.8" Height="4.2"
                    Background="{DynamicResource BatteryBorderBrush}"
                    CornerRadius="0,1.2,1.2,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Percent text with tabular figures -->
        <TextBlock x:Name="PercentText"
                   Text="100%"
                   FontSize="9.5"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource BatteryTextBrush}"
                   VerticalAlignment="Center"
                   Margin="3.5,0,0,0"
                   Typography.NumeralAlignment="Tabular"/>
    </StackPanel>
</UserControl>
