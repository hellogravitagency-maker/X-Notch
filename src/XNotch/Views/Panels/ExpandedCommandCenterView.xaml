<UserControl x:Class="XNotch.Views.Panels.ExpandedCommandCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="560">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Components/IconButtonStyle.xaml"/>
                <ResourceDictionary Source="../Components/SegmentedRadioStyle.xaml"/>
                <ResourceDictionary Source="../Components/RoundedScrollBarStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MetricCardBorder" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SegmentedBgBrush}"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="4"/>
            </Style>

            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- Modern macOS Pill ProgressBar -->
            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="5"/>
                <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource ProgressFillBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2.5" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Segmented Navigation Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Segmented Pills for Tabs -->
            <Border Grid.Column="0"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource SegmentedBgBrush}"
                    CornerRadius="10"
                    Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabOverview" Content="Overview" Style="{StaticResource SegmentedRadio}"
                                 GroupName="CommandCenterTabs" IsChecked="True" Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabProjects" Content="Projects" Style="{StaticResource SegmentedRadio}"
                                 GroupName="CommandCenterTabs" Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabTasks" Content="Tasks" Style="{StaticResource SegmentedRadio}"
                                 GroupName="CommandCenterTabs" Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabSystem" Content="System" Style="{StaticResource SegmentedRadio}"
                                 GroupName="CommandCenterTabs" Checked="OnTabChanged"/>
                    <RadioButton x:Name="TabLyrics" Content="Lyrics" Style="{StaticResource SegmentedRadio}"
                                 GroupName="CommandCenterTabs" Checked="OnTabChanged"/>
                </StackPanel>
            </Border>

            <!-- Quick Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RescanButton" Style="{StaticResource IconButton}" Width="26" Height="26"
                        Margin="0,0,4,0" ToolTip="Rescan workspace &amp; agents" Click="OnRescanClick">
                    <TextBlock Text="↻" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="26" Height="26"
                        ToolTip="Close Command Center" Click="OnCloseClick">
                    <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area with Dynamic Views -->
        <Grid Grid.Row="1">
            <!-- 1. OVERVIEW TAB -->
            <Grid x:Name="ViewOverview" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Daily Briefing Banner -->
                <Border Grid.Row="0" CornerRadius="10" Background="{DynamicResource SegmentedBgBrush}" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="GreetingText" Text="Good day, Developer" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="SubGreetingText" Text="Command Center active. Ready for instructions." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Padding="8,4" Background="#2230D158" Click="OnSpotlightQuickClick" ToolTip="Open Spotlight Launcher (Ctrl+Space)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Spotlight" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Overview Summary Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Agent Status Card -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCardBorder}" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE CODING AGENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#2A30D158" Margin="0,0,8,0">
                                    <TextBlock x:Name="AgentGlyph" Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AgentStatusTitle" Text="No Agent Active" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="AgentStatusDetail" Text="Processes monitored in background" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <Button x:Name="FocusAgentTerminalButton" Margin="0,10,0,0" Padding="8,4"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{DynamicResource NotchFillBrush}" BorderBrush="{DynamicResource NotchBorderBrush}" BorderThickness="1"
                                    Click="OnFocusAgentTerminalClick">
                                <TextBlock Text="Focus Terminal" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Quick Workspace Stats Card -->
                    <Border Grid.Column="1" Style="{StaticResource MetricCardBorder}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="INTELLIGENCE SUMMARY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="ProjectCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Projects" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="TaskCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Active Tasks" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="RecentReminderText" Text="All project deadlines on track" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 2. PROJECTS TAB -->
            <Grid x:Name="ViewProjects" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Discovered Repositories &amp; Workspaces" Style="{StaticResource SectionHeading}"/>
                <ScrollViewer Grid.Row="1" Style="{StaticResource RoundedScrollViewer}" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl x:Name="ProjectsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="{DynamicResource SegmentedBgBrush}" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Border CornerRadius="4" Background="{DynamicResource SurfaceBrush}" Padding="4,1" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding TechStack}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding GitBranch, StringFormat=' ({0})'}" FontSize="10" Foreground="{DynamicResource TextDimBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Resume" Padding="8,4" FontSize="10" VerticalAlignment="Center"
                                                Tag="{Binding Path}" Click="OnResumeProjectClick"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 3. TASKS TAB -->
            <Grid x:Name="ViewTasks" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Pending Project Tasks (TODO / Checklist)" Style="{StaticResource SectionHeading}"/>
                <ScrollViewer Grid.Row="1" Style="{StaticResource RoundedScrollViewer}" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <ItemsControl x:Name="TasksItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="{DynamicResource SegmentedBgBrush}" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Checked="OnTaskChecked" Unchecked="OnTaskUnchecked"
                                                  Tag="{Binding Id}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding SourceEvidence, StringFormat='Source: {0}'}" FontSize="9.5" Foreground="{DynamicResource TextDimBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="4" Background="{DynamicResource SurfaceBrush}" Padding="5,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 4. SYSTEM TELEMETRY TAB -->
            <Grid x:Name="ViewSystem" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CPU Card -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource MetricCardBorder}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PROCESSOR (CPU)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="CpuUsageText" Text="0.0 %" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            <ProgressBar x:Name="CpuProgressBar" Height="4" Margin="0,6,0,0" Value="0" Maximum="100"/>
                            <TextBlock x:Name="CpuInfoText" Text="Intel Core i7-12700H" FontSize="9" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Memory Card -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource MetricCardBorder}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MEMORY (RAM)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="RamUsageText" Text="0.0 %" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            <ProgressBar x:Name="RamProgressBar" Height="4" Margin="0,6,0,0" Value="0" Maximum="100"/>
                            <TextBlock x:Name="RamDetailText" Text="0 MB / 0 MB" FontSize="9" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- GPU Card -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource MetricCardBorder}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GRAPHICS (GPU / VRAM)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="GpuTempText" Text="-- °C" FontSize="18" FontWeight="Bold" Foreground="#30D158"/>
                                <TextBlock x:Name="GpuNameText" Text="NVIDIA RTX 3050" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                            </StackPanel>
                            <ProgressBar x:Name="VramProgressBar" Height="4" Margin="0,6,0,0" Value="0" Maximum="100"/>
                            <TextBlock x:Name="VramDetailText" Text="VRAM: 0 MB" FontSize="9" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Storage & Network Card -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCardBorder}">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="STORAGE &amp; NETWORK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="DiskDetailText" Text="Disk C: -- %" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                            <ProgressBar x:Name="DiskProgressBar" Height="4" Margin="0,6,0,0" Value="0" Maximum="100"/>
                            <TextBlock x:Name="NetworkDetailText" Text="Down: 0 KB/s • Up: 0 KB/s" FontSize="9" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. LYRICS TAB -->
            <Grid x:Name="ViewLyrics" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LyricsTrackTitle" Text="Track Lyrics" Style="{StaticResource SectionHeading}" Grid.Column="0"/>
                    <TextBlock x:Name="LyricsSourceLabel" Text="LRCLIB Synced" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Grid.Column="1" VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer x:Name="LyricsScrollViewer" Grid.Row="1" Style="{StaticResource RoundedScrollViewer}" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                    <StackPanel x:Name="LyricsContainerPanel" Margin="4">
                        <TextBlock x:Name="NoLyricsNotice" Text="No synchronized lyrics available for current track."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,40,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
