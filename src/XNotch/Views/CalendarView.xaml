<UserControl x:Class="XNotch.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220"
             Height="130"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
                <ResourceDictionary Source="Components/RoundedScrollBarStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid VerticalAlignment="Stretch" Background="Transparent">
        <!-- View 0: Simple Date & Day Glance (Apple macOS Widget Style - Default on Open) -->
        <Border x:Name="DateGlanceView" Visibility="Visible"
                Background="#0EFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                CornerRadius="14" Padding="12,10"
                Cursor="Hand" MouseLeftButtonDown="OnDateGlanceClick"
                ToolTip="Click to view full calendar">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF"/>
                            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Apple Calendar Iconic Tear-Off Block -->
                <Border Grid.Column="0" Width="56" Height="68" CornerRadius="12"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Top Crimson Banner -->
                        <Border Grid.Row="0" Background="#FF3B30">
                            <TextBlock x:Name="GlanceMonthText" Text="NOV"
                                       FontSize="9.5" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Bottom Date & Day -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="GlanceDayNumberText" Text="1"
                                       FontSize="23" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,-2,0,-1"/>
                            <TextBlock x:Name="GlanceDayOfWeekText" Text="SUN"
                                       FontSize="8" FontWeight="Bold"
                                       Foreground="#FF453A"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Side Info & Click to Reveal Full Calendar -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="GlanceDayTitleText" Text="Sunday"
                               FontSize="13.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="GlanceFullDateText" Text="November 1, 2026"
                               FontSize="10.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,1,0,3"/>
                    <TextBlock x:Name="GlanceSnippetText" Text="📅 0 events today"
                               FontSize="9.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,6"/>

                    <!-- Action pill -->
                    <Border HorizontalAlignment="Left" CornerRadius="9"
                            Background="#180A84FF" BorderBrush="#450A84FF" BorderThickness="1"
                            Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Full Calendar" FontSize="8.5" FontWeight="SemiBold" Foreground="#0A84FF" VerticalAlignment="Center"/>
                            <TextBlock Text=" ›" FontSize="9.5" FontWeight="Bold" Foreground="#0A84FF" VerticalAlignment="Center" Margin="2,-1,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- View 1: Full Month Calendar Grid (Mac menu bar & Dynamic Island style) -->
        <Grid x:Name="MonthGridView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Month Header: < MONTH YEAR > and Today Jump / Agenda Toggle -->
            <Grid Grid.Row="0" Margin="2,0,2,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Back to simple glance button -->
                    <Button Style="{StaticResource IconButton}" Width="18" Height="18" Margin="0,0,4,0"
                            Click="OnBackToGlanceClick" ToolTip="Back to simple date view">
                        <TextBlock Text="‹" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,-2,0,0"/>
                    </Button>
                    <TextBlock x:Name="MonthYearText"
                               Text="NOVEMBER 2026"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Border x:Name="TodayBadge"
                            Background="#250A84FF" CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                            Cursor="Hand" MouseLeftButtonUp="OnTodayClick"
                            ToolTip="Jump to today">
                        <TextBlock Text="Today" FontSize="8.5" FontWeight="Bold" Foreground="#0A84FF"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Prev Month -->
                    <Button Style="{StaticResource IconButton}" Width="18" Height="18"
                            Click="OnPrevMonthClick" ToolTip="Previous month">
                        <TextBlock Text="‹" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,-2,0,0"/>
                    </Button>
                    <!-- Next Month -->
                    <Button Style="{StaticResource IconButton}" Width="18" Height="18" Margin="2,0,4,0"
                            Click="OnNextMonthClick" ToolTip="Next month">
                        <TextBlock Text="›" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,-2,0,0"/>
                    </Button>
                    <!-- Agenda Toggle Button -->
                    <Button x:Name="AgendaToggleButton" Style="{StaticResource IconButton}" Width="18" Height="18"
                            Click="OnToggleAgendaClick" ToolTip="View upcoming agenda">
                        <TextBlock Text="📋" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Days of Week Header (S M T W T F S) -->
            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,2">
                <TextBlock Text="S" FontSize="8" FontWeight="Bold" Foreground="#80FF453A" HorizontalAlignment="Center"/>
                <TextBlock Text="M" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="T" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="W" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="T" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="F" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="S" FontSize="8" FontWeight="Bold" Foreground="#800A84FF" HorizontalAlignment="Center"/>
            </UniformGrid>

            <!-- 7x6 Day Cells Grid -->
            <UniformGrid x:Name="DaysGrid" Grid.Row="2" Columns="7" VerticalAlignment="Stretch" Margin="0,1,0,0"/>
        </Grid>

        <!-- View 2: Day Agenda & Upcoming Events -->
        <Grid x:Name="AgendaView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Back to Grid button -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OnBackToGridClick"
                            Style="{StaticResource IconButton}"
                            Width="20" Height="20"
                            ToolTip="Back to calendar">
                        <Border Width="18" Height="18" CornerRadius="9"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="‹" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,1,0"/>
                        </Border>
                    </Button>
                    <TextBlock x:Name="AgendaDateTitle" Text="Today's Agenda" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- + Task / Reminder Button with Apple Emerald Glass styling -->
                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Height="20" Padding="6,1"
                        Click="OnOpenTaskReminderFromAgendaClick"
                        ToolTip="Add task or reminder for this date">
                    <Border CornerRadius="10" Background="#3230D158" BorderBrush="#7030D158" BorderThickness="1" Padding="6,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+" FontSize="11" FontWeight="Bold" Foreground="#30D158" Margin="0,0,3,0"/>
                            <TextBlock Text="Task / Reminder" FontSize="8.5" FontWeight="SemiBold" Foreground="#30D158"/>
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>

            <!-- Events List -->
            <ScrollViewer x:Name="AgendaScrollViewer" Grid.Row="1" MaxHeight="98"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Background="Transparent"
                          PreviewMouseWheel="OnAgendaPreviewMouseWheel"
                          Style="{StaticResource RoundedScrollViewer}">
                <StackPanel x:Name="EventsPanel"/>
            </ScrollViewer>
        </Grid>

        <!-- View 3: Day Tasks & Reminders Editor (Opened via Double-Click on any date) -->
        <Grid x:Name="TaskReminderView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Back button and Date Label -->
            <Grid Grid.Row="0" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OnBackFromTaskReminderClick"
                            Style="{StaticResource IconButton}"
                            Width="20" Height="20"
                            ToolTip="Back to calendar">
                        <Border Width="18" Height="18" CornerRadius="9"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="‹" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,1,0"/>
                        </Border>
                    </Button>
                    <TextBlock x:Name="TaskReminderDateTitle" Text="TODAY" FontSize="9.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Toggle Item Type (Reminder vs Task) -->
                <Button x:Name="ToggleItemTypeButton" Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Height="18" Padding="5,0"
                        Click="OnToggleItemTypeClick"
                        ToolTip="Toggle between Reminder and Task">
                    <Border x:Name="ItemTypePill" CornerRadius="8" Background="#25FF9F0A" BorderBrush="#60FF9F0A" BorderThickness="1" Padding="5,1">
                        <TextBlock x:Name="ItemTypeText" Text="🔔 Reminder" FontSize="8.5" FontWeight="SemiBold" Foreground="#FF9F0A"/>
                    </Border>
                </Button>
            </Grid>

            <!-- Input Box for New Task/Reminder -->
            <Border x:Name="TaskReminderInputBorder" Grid.Row="1" Background="#16FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                    CornerRadius="8" Padding="7,3" Margin="0,0,0,4" Cursor="IBeam"
                    MouseLeftButtonDown="OnTaskReminderInputContainerMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewTaskReminderInput"
                             Grid.Column="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="#30D158"
                             FontSize="10"
                             VerticalAlignment="Center"
                             Focusable="True"
                             IsTabStop="True"
                             Cursor="IBeam"
                             PreviewMouseLeftButtonDown="OnTaskReminderInputMouseDown"
                             KeyDown="OnNewTaskReminderKeyDown"/>
                    <TextBlock x:Name="TaskReminderInputPlaceholder"
                               Grid.Column="0"
                               Text="+ Add task (Press Enter)..."
                               FontSize="10"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextFaintBrush}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                    <Button x:Name="AddTaskReminderButton"
                            Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Width="18" Height="18"
                            Click="OnAddTaskReminderClick"
                            ToolTip="Add item (Enter)">
                        <TextBlock Text="+" FontSize="12" FontWeight="Bold" Foreground="#30D158"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrollable Tasks & Reminders List for Selected Date -->
            <ScrollViewer x:Name="TaskReminderScrollViewer" Grid.Row="2" MaxHeight="78"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          Background="Transparent"
                          PreviewMouseWheel="OnTaskReminderPreviewMouseWheel"
                          Style="{StaticResource RoundedScrollViewer}">
                <StackPanel x:Name="TaskReminderListPanel">
                    <Border x:Name="EmptyTaskReminderPlaceholder" Background="#0CFFFFFF" CornerRadius="6" Padding="8,10" Margin="0,2,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📝" FontSize="13" HorizontalAlignment="Center" Opacity="0.5" Margin="0,0,0,2"/>
                            <TextBlock Text="No tasks or reminders for this date"
                                       FontSize="9.5" FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFaintestBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
