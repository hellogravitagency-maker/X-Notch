<UserControl x:Class="XNotch.Views.AIIntelligenceWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:XNotch.Views.Components"
             Height="128"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
                <ResourceDictionary Source="Components/RoundedScrollBarStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="AiQuickButton" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0.8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegmentedHoverBgBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SegmentedCheckedBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="6,0" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <comp:XNotchLogo Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="AI INTELLIGENCE &amp; AGENTS" FontSize="9.5" FontWeight="Bold"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <Border x:Name="ProviderBadge" Background="#180A84FF" BorderBrush="#300A84FF" BorderThickness="0.8"
                        CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#30D158" Margin="0,0,4,0"/>
                        <TextBlock x:Name="ProviderNameText" Text="Ollama / Local" FontSize="8.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DailyBriefingButton" Style="{StaticResource AiQuickButton}" Click="OnDailyBriefingClick"
                        ToolTip="Generate Autonomous Daily Briefing" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌅 " FontSize="9.5"/>
                        <TextBlock Text="Briefing" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ScanProjectsButton" Style="{StaticResource AiQuickButton}" Click="OnScanProjectsClick"
                        ToolTip="Scan Workspaces for Projects &amp; Tasks">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↻ " FontSize="9.5"/>
                        <TextBlock Text="Scan" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content Area: Prompt Input / Output Preview -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0.8" CornerRadius="8" Padding="8,4" Margin="0,2,0,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource RoundedScrollViewer}">
                <TextBlock x:Name="OutputTextBlock"
                           Text="AI Assistant ready. Ask questions, summarize tasks, or generate your morning briefing."
                           FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" LineHeight="14"/>
            </ScrollViewer>
        </Border>

        <!-- Input Bar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0.8" CornerRadius="7" Padding="6,2" Margin="0,0,4,0">
                <Grid>
                    <TextBox x:Name="PromptInputBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource AccentPrimaryBrush}"
                             FontSize="10.5" VerticalAlignment="Center" KeyDown="OnPromptKeyDown"/>
                    <TextBlock x:Name="PlaceholderText" Text="Ask local AI, summarize work, or run automation..."
                               FontSize="10" FontStyle="Italic" Foreground="{DynamicResource TextDimBrush}"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource AiQuickButton}" Width="26" Height="24"
                    Padding="0" Click="OnSendClick" ToolTip="Send prompt (Enter)">
                <TextBlock Text="↑" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Grid>
</UserControl>
