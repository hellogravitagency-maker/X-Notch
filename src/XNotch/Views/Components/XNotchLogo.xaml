<UserControl x:Class="XNotch.Views.Components.XNotchLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20">
    <Viewbox Stretch="Uniform">
        <Canvas Width="64" Height="64">
            <!-- Ambient Background Glow -->
            <Ellipse Width="54" Height="54" Canvas.Left="5" Canvas.Top="5" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0A84FF" Offset="0.0"/>
                        <GradientStop Color="Transparent" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Continuous Curvature Ribbon 1: Top-Left to Bottom-Right -->
            <Path Data="M 14,14 C 18,14 26,22 32,32 C 38,42 46,50 50,50 C 53,50 55,47 55,44 C 55,40 45,30 36,20 C 27,10 18,9 14,14 Z"
                  StrokeThickness="0">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0A84FF" Offset="0.0"/>
                        <GradientStop Color="#64D2FF" Offset="0.7"/>
                        <GradientStop Color="#A1A1AA" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- Continuous Curvature Ribbon 2: Top-Right to Bottom-Left -->
            <Path Data="M 50,14 C 46,14 38,22 32,32 C 26,42 18,50 14,50 C 11,50 9,47 9,44 C 9,40 19,30 28,20 C 37,10 46,9 50,14 Z"
                  StrokeThickness="0" Opacity="0.92">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="#64D2FF" Offset="0.0"/>
                        <GradientStop Color="#0A84FF" Offset="0.6"/>
                        <GradientStop Color="#30D158" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- Center Dynamic Aperture Core (Notch Island Focal Point) -->
            <Ellipse Width="10" Height="10" Canvas.Left="27" Canvas.Top="27">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#64D2FF" Offset="0.6"/>
                        <GradientStop Color="#0A84FF" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
    </Viewbox>
</UserControl>
