<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ White Theme (Pure Clean Snow White) ═══ -->

    <!-- Notch: Pure white fill with refined subtle hairline border & soft elevation -->
    <SolidColorBrush x:Key="NotchFillBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="NotchShadowBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="NotchBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ShelfBadgeBgBrush" Color="#12000000"/>
    <SolidColorBrush x:Key="ShelfBadgeBorderBrush" Color="#25000000"/>
    <SolidColorBrush x:Key="DropZoneGlowBrush" Color="#33007AFF"/>

    <!-- Text hierarchy — crisp pure black and deep neutral charcoals -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF242426"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF444446"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF636366"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF7C7C80"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#FF8E8E93"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#FFAEAEB2"/>
    <SolidColorBrush x:Key="TextFaintestBrush" Color="#FFC7C7CC"/>
    <SolidColorBrush x:Key="SettingLabelBrush" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="BatteryTextBrush" Color="#FF000000"/>

    <!-- Surfaces — pristine white with subtle silver dividers -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="SegmentedBgBrush" Color="#FFF2F2F7"/>
    <SolidColorBrush x:Key="SegmentedCheckedBgBrush" Color="#FFFFFFFF"/>

    <!-- Toggle switch -->
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#FFE5E5EA"/>
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFFFF"/>

    <!-- Segmented radio text -->
    <SolidColorBrush x:Key="SegmentedTextBrush" Color="#FF636366"/>
    <SolidColorBrush x:Key="SegmentedHoverBgBrush" Color="#15000000"/>
    <SolidColorBrush x:Key="SegmentedHoverTextBrush" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="SegmentedCheckedTextBrush" Color="#FF000000"/>

    <!-- Overlays / hover -->
    <SolidColorBrush x:Key="TransportHoverBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="TransportPressedBrush" Color="#28000000"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#10000000"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#20000000"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#30000000"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#50000000"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#70000000"/>

    <!-- Battery -->
    <SolidColorBrush x:Key="BatteryBorderBrush" Color="#FF8E8E93"/>
    <SolidColorBrush x:Key="BatteryNormalFillBrush" Color="#FF000000"/>

    <!-- HUD -->
    <SolidColorBrush x:Key="HudIconBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="HudSliderFillBrush" Color="#FF000000"/>

    <!-- Audio visualizer -->
    <Color x:Key="VisualizerBarColor">#FF000000</Color>

</ResourceDictionary>
