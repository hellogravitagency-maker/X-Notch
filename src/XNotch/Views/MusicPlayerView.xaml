<UserControl x:Class="XNotch.Views.MusicPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:XNotch.Views.Components">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/MarqueeTextStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Apple Dynamic Island Glass Transport Button -->
            <Style x:Key="TransportButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    CornerRadius="16"
                                    RenderTransformOrigin="0.5,0.5"
                                    Padding="{TemplateBinding Padding}">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="BtnScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TransportHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TransportPressedBrush}"/>
                                    <Setter TargetName="Bg" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.90" ScaleY="0.90"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Hero Circular Play/Pause Button with Dynamic Theme Styling -->
            <Style x:Key="HeroPlayButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SegmentedCheckedBgBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="19"
                                    RenderTransformOrigin="0.5,0.5"
                                    Padding="{TemplateBinding Padding}">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="BtnScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#38FFFFFF"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#60FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#50FFFFFF"/>
                                    <Setter TargetName="Bg" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.91" ScaleY="0.91"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Album art with atmospheric diffuse glow and specular chamfer -->
        <Grid x:Name="AlbumArtGrid" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
            <!-- Background diffuse glow from album art -->
            <Border x:Name="AlbumGlow"
                    Width="90" Height="90"
                    CornerRadius="14"
                    Opacity="0.40">
                <Border.Background>
                    <ImageBrush x:Name="GlowBrush" Stretch="UniformToFill"/>
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="14"/>
                </Border.Effect>
            </Border>

            <!-- Album art with Apple continuous squircle clip and hairline rim -->
            <Border Width="90" Height="90"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#35FFFFFF"
                    ClipToBounds="True">
                <Image x:Name="AlbumArtImage"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>

        <!-- Right side: track information, liquid scrubber, and transport cluster -->
        <Grid x:Name="InfoControlsGrid" Grid.Column="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Song title and multi-session switcher -->
            <Grid Grid.Row="0" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <comp:MarqueeText x:Name="TitleText"
                                  Grid.Column="0"
                                  FontSize="14.5"
                                  FontWeight="Bold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Height="22"/>

                <StackPanel x:Name="SessionSwitchPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button Style="{StaticResource TransportButton}" Width="20" Height="20" Click="OnPrevSessionClick" ToolTip="Previous Player">
                        <TextBlock Text="‹" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Button>
                    <TextBlock x:Name="SessionIndicatorText" Text="1/1" FontSize="10" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0"/>
                    <Button Style="{StaticResource TransportButton}" Width="20" Height="20" Click="OnNextSessionClick" ToolTip="Next Player">
                        <TextBlock Text="›" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Artist and Apple Lossless badge -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                <comp:MarqueeText x:Name="ArtistText"
                                  FontSize="11.5"
                                  FontWeight="Normal"
                                  Foreground="{DynamicResource TextTertiaryBrush}"
                                  Height="18"
                                  MaxWidth="240"/>

                <!-- Apple Music Lossless Micro Badge -->
                <Border Margin="8,0,0,0" Padding="4,1"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.8"
                        CornerRadius="3.5" Background="{DynamicResource SurfaceBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="LOSSLESS" FontSize="7.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular"/>
                </Border>
            </StackPanel>

            <!-- Apple Liquid Scrubber Progress Bar -->
            <Grid Grid.Row="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ElapsedText"
                           Grid.Column="0"
                           Text="0:00"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="10"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Typography.NumeralAlignment="Tabular"/>

                <Border Grid.Column="1"
                        Height="5"
                        CornerRadius="2.5"
                        Background="{DynamicResource ProgressTrackBrush}"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ClipToBounds="True"
                        MouseLeftButtonDown="OnProgressBarClick">
                    <Border x:Name="ProgressFill"
                            Height="5"
                            CornerRadius="2.5"
                            Background="{DynamicResource ProgressFillBrush}"
                            HorizontalAlignment="Left"/>
                </Border>

                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           Text="0:00"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="10"
                           FontWeight="Medium"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Typography.NumeralAlignment="Tabular"/>
            </Grid>

            <!-- Apple Glass Transport Controls -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <!-- Shuffle -->
                <Button x:Name="ShuffleButton"
                        Click="OnShuffleClick"
                        Style="{StaticResource TransportButton}"
                        Margin="0,0,10,0"
                        ToolTip="Shuffle">
                    <TextBlock Text="🔀" FontSize="13"/>
                </Button>

                <!-- Previous -->
                <Button x:Name="PrevButton"
                        Click="OnPrevClick"
                        Style="{StaticResource TransportButton}"
                        Margin="0,0,8,0"
                        ToolTip="Previous Track">
                    <TextBlock Text="⏮" FontSize="15"/>
                </Button>

                <!-- Hero Play/Pause -->
                <Button x:Name="PlayPauseButton"
                        Click="OnPlayPauseClick"
                        Style="{StaticResource HeroPlayButton}"
                        Margin="4,0,4,0"
                        ToolTip="Play / Pause">
                    <TextBlock x:Name="PlayPauseIcon" Text="▶" FontSize="16" Margin="1,0,0,0"/>
                </Button>

                <!-- Next -->
                <Button x:Name="NextButton"
                        Click="OnNextClick"
                        Style="{StaticResource TransportButton}"
                        Margin="8,0,0,0"
                        ToolTip="Next Track">
                    <TextBlock Text="⏭" FontSize="15"/>
                </Button>

                <!-- Repeat -->
                <Button x:Name="RepeatButton"
                        Click="OnRepeatClick"
                        Style="{StaticResource TransportButton}"
                        Margin="10,0,0,0"
                        ToolTip="Repeat">
                    <TextBlock x:Name="RepeatIcon" Text="🔁" FontSize="13"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- No media placeholder -->
        <TextBlock x:Name="NoMediaText"
                   Grid.ColumnSpan="2"
                   Text="No music playing"
                   Foreground="{DynamicResource TextFaintBrush}"
                   FontSize="14"
                   FontWeight="Medium"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
