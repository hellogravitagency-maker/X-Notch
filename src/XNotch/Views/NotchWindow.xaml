<Window x:Class="XNotch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:XNotch.Views"
        xmlns:panels="clr-namespace:XNotch.Views.Panels"
        xmlns:comp="clr-namespace:XNotch.Views.Components"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        Title="X-Notch">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Apple Dynamic Island Carousel Navigation Arrow (Static, non-shifting) -->
            <Style x:Key="CarouselArrowButton" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="#15FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#25FFFFFF"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="58"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="Scale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#35FFFFFF"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#55FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#50FFFFFF"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#65FFFFFF"/>
                                    <Setter TargetName="Bg" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Fixed-size window; notch shape animates inside it. No window resizing. -->
    <Grid x:Name="RootGrid">
        <Canvas x:Name="NotchCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">

            <!-- Ambient aura & shadow light — disabled for pure clean cutout -->
            <Path x:Name="AmbientAuraPath" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- Shadow layer — disabled -->
            <Path x:Name="ShadowPath"
                  Fill="{DynamicResource NotchShadowBrush}"
                  Opacity="0"
                  Visibility="Collapsed"/>

            <!-- Liquid Glass: refracted + vibrancy-boosted backdrop; GPU blur on top -->
            <Path x:Name="BackdropBlurPath" Opacity="0" IsHitTestVisible="False">
                <Path.Effect>
                    <BlurEffect Radius="22" KernelType="Gaussian"/>
                </Path.Effect>
            </Path>

            <!-- Camera hover sensor (sensor strip positioned directly under top camera) -->
            <Border x:Name="CameraTriggerZone"
                    Background="#01000000"
                    IsHitTestVisible="True"
                    Cursor="Hand"/>

            <!-- Main notch shape — seamless, borderless pure cutout (no border lighting) -->
            <Path x:Name="NotchPath"
                  Fill="{DynamicResource NotchFillBrush}"
                  Stroke="{x:Null}"
                  StrokeThickness="0"
                  Cursor="Hand"/>

            <!-- Specular rim, border lighting & inner shadow layers completely disabled -->
            <Path x:Name="GlassSpecularPath" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Path x:Name="GlassBorderPath" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Path x:Name="GlassInnerShadowPath" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- Clip region for content (matches notch shape) -->
            <Grid x:Name="ContentGrid" ClipToBounds="True">
                <!-- Closed state content with Apple Dynamic Island micro-scale spring -->
                <Grid x:Name="ClosedContent" Opacity="1" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ClosedContentScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Plugin closed content -->
                    <StackPanel x:Name="PluginClosedPanel" Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="6,0,0,0"/>

                    <views:MusicLiveActivity x:Name="LiveActivity"
                                             Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Margin="6,0,2,0"/>
                    <views:ClockWidget x:Name="ClockWidget"
                                       Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0"
                                       Visibility="Visible"/>

                    <!-- Badges Panel (File Shelf) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Shelf indicator badge -->
                        <Button x:Name="ShelfBadgeButton"
                                Style="{StaticResource IconButton}"
                                Click="OnShelfBadgeClick"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                Margin="2,0,4,0"
                                Padding="0"
                                ToolTip="Files on shelf — Click to open">
                            <Border Background="{DynamicResource ShelfBadgeBgBrush}"
                                    BorderBrush="{DynamicResource ShelfBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Height="18"
                                    Padding="4,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📎" FontSize="9" Margin="0,0,3,0"/>
                                    <TextBlock x:Name="ShelfBadgeCountText" Text="1"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Privacy Indicators (Apple Green Camera & Amber Microphone Glowing Dots) -->
                        <StackPanel x:Name="PrivacyDotsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,0">
                            <!-- Camera Privacy Dot -->
                            <Border x:Name="CameraPrivacyDot" Width="6" Height="6" CornerRadius="3"
                                    Background="#30D158" Margin="2,0,2,0" Visibility="Collapsed"
                                    ToolTip="Camera is active">
                                <Border.Effect>
                                    <DropShadowEffect Color="#30D158" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                            </Border>
                            <!-- Microphone Privacy Dot -->
                            <Border x:Name="MicrophonePrivacyDot" Width="6" Height="6" CornerRadius="3"
                                    Background="#FF9F0A" Margin="2,0,2,0" Visibility="Collapsed"
                                    ToolTip="Microphone is active">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF9F0A" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                </Border.Effect>
                            </Border>
                        </StackPanel>

                        <!-- Compact Countdown Timer Pill in Closed Notch -->
                        <Border x:Name="TimerCompactBadge"
                                Background="#22FFA000" CornerRadius="6"
                                Padding="5,1" Margin="2,0,3,0"
                                Visibility="Collapsed"
                                Cursor="Hand" MouseLeftButtonUp="OnTimerBadgeClick"
                                ToolTip="Focus Timer — Click to control">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="9" Margin="0,0,3,0"/>
                                <TextBlock x:Name="TimerCompactText" Text="25:00" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFA000"/>
                            </StackPanel>
                        </Border>


                    </StackPanel>

                    <views:BatteryIndicator x:Name="BatteryIndicator"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"/>
                    <views:HudOverlay x:Name="HudOverlay"
                                      Grid.ColumnSpan="4"
                                      VerticalAlignment="Center"
                                      Margin="6,0,6,0"/>
                </Grid>

                <!-- Dedicated Shelf Drop Capsule (elastic pull-down target when dragging files) -->
                <Grid x:Name="ShelfDropCapsule" Opacity="0" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="8,4,8,6"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ShelfDropScale" ScaleX="0.90" ScaleY="0.90"/>
                            <TranslateTransform x:Name="ShelfDropTranslate" Y="-2"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border CornerRadius="10"
                            Background="{DynamicResource DropZoneGlowBrush}"
                            BorderBrush="{DynamicResource NotchBorderBrush}"
                            BorderThickness="1.5"
                            Padding="6">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="24" Height="24" CornerRadius="7" Margin="0,0,0,3" HorizontalAlignment="Center"
                                    BorderThickness="1" BorderBrush="#50FFFFFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF6366F1" Offset="0.0"/>
                                        <GradientStop Color="#FF8B5CF6" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <TextBlock Text="📥" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Drop to Shelf" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Temporary storage &amp; quick access" FontSize="9"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Incoming Toast Notification Capsule (Apple Dynamic Island transient alert) -->
                <Grid x:Name="NotificationCapsule" Opacity="0" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,8,0"
                      RenderTransformOrigin="0.5,0.5" Cursor="Hand" MouseLeftButtonUp="OnNotificationCapsuleClick">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="NotificationCapsuleScale" ScaleX="0.88" ScaleY="0.88"/>
                            <TranslateTransform x:Name="NotificationCapsuleTranslate" Y="-3"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vibrant Squircle Icon Container with Micro Scale Spring -->
                    <Border x:Name="NotificationIconBorder"
                            Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="7"
                            Background="#0A84FF"
                            BorderThickness="0"
                            BorderBrush="{x:Null}"
                            Margin="0,0,9,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="NotificationIconScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="NotificationIconShadow"
                                              Color="#0A84FF"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.45"/>
                        </Border.Effect>
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="NotificationAppIconImage"
                                   Width="20" Height="20"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed"/>
                            <TextBlock x:Name="NotificationIconText"
                                       Text="🔔"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NotificationTitleText"
                                   Text="Notification"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotificationBodyText"
                                   Text="Message body..."
                                   FontSize="9.5"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <Button x:Name="DismissNotificationButton"
                            Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Width="22" Height="22"
                            Margin="6,0,0,0"
                            Click="OnDismissNotificationClick"
                            ToolTip="Dismiss">
                        <Border Width="18" Height="18" CornerRadius="9" Background="#18FFFFFF">
                            <TextBlock Text="✕" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                </Grid>

                <!-- Interactive Coding Agent Approval Prompt Capsule -->
                <Grid x:Name="AgentApprovalCapsule" Opacity="0" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,8,0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="AgentApprovalScale" ScaleX="0.88" ScaleY="0.88"/>
                            <TranslateTransform x:Name="AgentApprovalTranslate" Y="-3"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Glowing Electric Amber Badge with Micro Scale Spring -->
                    <Border x:Name="AgentApprovalIconBorder"
                            Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="7"
                            BorderThickness="1"
                            BorderBrush="#60FFA000"
                            Margin="0,0,9,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFF9F0A" Offset="0.0"/>
                                <GradientStop Color="#FFFF6A00" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="AgentApprovalIconScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF9F0A" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <TextBlock x:Name="AgentGlyphText" Text="⚡" FontSize="13" Foreground="Black" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="AgentPromptTitle" Text="Approval Required" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#FF9F0A" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="AgentPromptCommand" Text="git push origin main" FontSize="9.5"
                                   FontFamily="Cascadia Code, Consolas"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <Button x:Name="ApproveButton" Grid.Column="2"
                            Background="#30D158" Foreground="Black" FontWeight="Bold" FontSize="10"
                            Padding="8,2" Height="22" Margin="0,0,4,0"
                            Click="OnApproveAgentClick" ToolTip="Allow tool execution (Enter)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Allow"/>
                    </Button>

                    <Button x:Name="DenyButton" Grid.Column="3"
                            Background="#FF453A" Foreground="White" FontWeight="Bold" FontSize="10"
                            Padding="8,2" Height="22"
                            Click="OnDenyAgentClick" ToolTip="Deny tool execution (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.65"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Deny"/>
                    </Button>
                </Grid>

                <!-- Power & Battery Charging Surge Capsule -->
                <Grid x:Name="PowerSurgeCapsule" Opacity="0" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,8,0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PowerSurgeScale" ScaleX="0.88" ScaleY="0.88"/>
                            <TranslateTransform x:Name="PowerSurgeTranslate" Y="-3"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PowerSurgeIconBorder"
                            Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="7"
                            Background="#30D158"
                            Margin="0,0,9,0">
                        <Border.Effect>
                            <DropShadowEffect x:Name="PowerSurgeShadow" Color="#30D158" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                        </Border.Effect>
                        <TextBlock x:Name="PowerSurgeIconText" Text="⚡" FontSize="13" Foreground="Black" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PowerSurgeTitleText" Text="85% Charging" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PowerSurgeSubText" Text="Power Connected" FontSize="9.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Caps Lock / Num Lock Status Capsule -->
                <Grid x:Name="LockStateCapsule" Opacity="0" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,8,0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LockStateScale" ScaleX="0.88" ScaleY="0.88"/>
                            <TranslateTransform x:Name="LockStateTranslate" Y="-3"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="LockStateIconBorder"
                            Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="7"
                            Background="{DynamicResource SurfaceBrush}"
                            Margin="0,0,9,0">
                        <TextBlock x:Name="LockStateIconText" Text="⇪" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LockStateTitleText" Text="CAPS LOCK ON" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- USB & External Storage Drive Capsule -->
                <Grid x:Name="UsbDriveCapsule" Opacity="0" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,8,0"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="UsbDriveScale" ScaleX="0.88" ScaleY="0.88"/>
                            <TranslateTransform x:Name="UsbDriveTranslate" Y="-3"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="7"
                            Background="#0A84FF"
                            Margin="0,0,9,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#0A84FF" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                        </Border.Effect>
                        <TextBlock Text="💾" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UsbDriveTitleText" Text="USB Drive (E:) Connected" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="UsbDriveSubText" Text="64 GB Available" FontSize="9.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>

                    <Button x:Name="OpenUsbDriveButton"
                            Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Width="44" Height="22"
                            Margin="6,0,0,0"
                            Click="OnOpenUsbDriveClick"
                            ToolTip="Open in File Explorer">
                        <Border CornerRadius="6" Background="{DynamicResource SurfaceBrush}" Padding="6,2">
                            <TextBlock Text="Open" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </Button>
                </Grid>

                <!-- Armoury Crate / Performance Operating Mode Alert Capsule -->
                <Grid x:Name="OperatingModeCapsule" Opacity="0" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,8,0"
                      RenderTransformOrigin="0.5,0.5" Cursor="Hand" MouseLeftButtonUp="OnOperatingModeCapsuleClick"
                      ToolTip="Click to open Power &amp; Performance settings">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="OperatingModeScale" ScaleX="0.88" ScaleY="0.88"/>
                            <TranslateTransform x:Name="OperatingModeTranslate" Y="-3"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="OperatingModeIconBorder"
                            Grid.Column="0"
                            Width="24" Height="24"
                            CornerRadius="7"
                            Background="#0A84FF"
                            Margin="0,0,9,0">
                        <Border.Effect>
                            <DropShadowEffect x:Name="OperatingModeShadow" Color="#0A84FF" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                        </Border.Effect>
                        <TextBlock x:Name="OperatingModeIconText" Text="⚡" FontSize="13" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="OperatingModeTitleText" Text="PERFORMANCE MODE" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="OperatingModeSubText" Text="Dynamic Fans • Balanced Boost" FontSize="9.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Open state content with Apple Dynamic Island zoom-and-bloom spring -->
                <Grid x:Name="OpenContent" Opacity="0" Margin="16,8,16,12" RenderTransformOrigin="0.5,0.0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="OpenContentScale" ScaleX="0.92" ScaleY="0.92"/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Main content (music + calendar) -->
                    <Grid x:Name="MainOpenContent" Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Open Notch Widget Carousel with Apple Dynamic Island Static Navigation Arrows -->
                        <Grid x:Name="CarouselContainer" Grid.Column="0" VerticalAlignment="Center" MouseWheel="OnCarouselMouseWheel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Side Navigation Arrow (Static, non-moving) -->
                            <Button x:Name="CarouselPrevArrow"
                                    Grid.Column="0"
                                    Click="OnCarouselPrevClick"
                                    MouseWheel="OnCarouselArrowMouseWheel"
                                    Style="{StaticResource CarouselArrowButton}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Previous Card (←)">
                                <TextBlock Text="‹" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,1,0"/>
                            </Button>

                            <!-- Carousel Cards Host with Hardware-Accelerated Smooth Transforms & Apple Page Dots -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid x:Name="CarouselCardHost" Grid.Row="0" Height="130" ClipToBounds="True">
                                    <views:MusicPlayerView x:Name="MusicPlayer" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                                        <views:MusicPlayerView.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="0" Y="0"/>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </TransformGroup>
                                        </views:MusicPlayerView.RenderTransform>
                                    </views:MusicPlayerView>

                                    <views:StopwatchWidgetView x:Name="StopwatchWidget" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <views:StopwatchWidgetView.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="0" Y="0"/>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </TransformGroup>
                                        </views:StopwatchWidgetView.RenderTransform>
                                    </views:StopwatchWidgetView>

                                    <views:WaterTrackerWidgetView x:Name="WaterWidget" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <views:WaterTrackerWidgetView.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="0" Y="0"/>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </TransformGroup>
                                        </views:WaterTrackerWidgetView.RenderTransform>
                                    </views:WaterTrackerWidgetView>

                                    <views:SleepTrackerWidgetView x:Name="SleepWidget" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <views:SleepTrackerWidgetView.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="0" Y="0"/>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </TransformGroup>
                                        </views:SleepTrackerWidgetView.RenderTransform>
                                    </views:SleepTrackerWidgetView>

                                    <views:TasksWidgetView x:Name="TasksWidget" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <views:TasksWidgetView.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="0" Y="0"/>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </TransformGroup>
                                        </views:TasksWidgetView.RenderTransform>
                                    </views:TasksWidgetView>

                                    <views:SystemVitalsWidgetView x:Name="VitalsWidget" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <views:SystemVitalsWidgetView.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="0" Y="0"/>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </TransformGroup>
                                        </views:SystemVitalsWidgetView.RenderTransform>
                                    </views:SystemVitalsWidgetView>

                                    <views:NotificationHistoryWidgetView x:Name="NotificationHistoryWidget" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                        <views:NotificationHistoryWidgetView.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform X="0" Y="0"/>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </TransformGroup>
                                        </views:NotificationHistoryWidgetView.RenderTransform>
                                    </views:NotificationHistoryWidgetView>
                                </Grid>

                                <!-- Dynamic Island Carousel Page Dots Indicator -->
                                <StackPanel x:Name="CarouselDotsPanel" Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,4,0,0"/>
                            </Grid>

                                <!-- Right Side Navigation Arrow (Static, non-moving) -->
                                <Button x:Name="CarouselNextArrow"
                                        Grid.Column="2"
                                        Click="OnCarouselNextClick"
                                        MouseWheel="OnCarouselArrowMouseWheel"
                                        Style="{StaticResource CarouselArrowButton}"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Next Card (→)">
                                    <TextBlock Text="›" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,-2,0,0"/>
                                </Button>
                            </Grid>

                        <!-- Calendar panel -->
                        <StackPanel x:Name="CalendarPanel" Grid.Column="1" Orientation="Horizontal">
                            <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="8,4,8,4"/>
                            <views:CalendarView x:Name="CalendarPanel_View"/>
                        </StackPanel>

                        <!-- Plugin accessory content -->
                        <StackPanel x:Name="PluginAccessoryPanel" Grid.Column="2" Orientation="Horizontal"
                                    Visibility="Collapsed"/>

                        <!-- Webcam mirror -->
                        <StackPanel x:Name="WebcamPanel" Grid.Column="3" Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="8,4,8,4"/>
                            <views:WebcamView x:Name="WebcamMirror"/>
                        </StackPanel>

                        <!-- Top right actions (Command Center & Settings) -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,0,0">
                            <Button x:Name="CommandCenterButton"
                                    Click="OnCommandCenterButtonClick"
                                    Style="{StaticResource IconButton}"
                                    Width="24" Height="24"
                                    Margin="0,0,2,0"
                                    ToolTip="Command Center &amp; Agent Hub">
                                <TextBlock Text="⚡" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}"/>
                            </Button>
                            <Button x:Name="SettingsGearButton"
                                    Click="OnSettingsGearClick"
                                    Style="{StaticResource IconButton}"
                                    Width="24" Height="24"
                                    ToolTip="Settings">
                                <TextBlock Text="⚙" FontSize="13" Foreground="{DynamicResource TextSubtleBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- File shelf (visible when files are shelved) -->
                    <views:ShelfView x:Name="ShelfPanel"
                                     Grid.Row="1"
                                     Visibility="Collapsed"
                                     Margin="0,4,0,0"/>

                    <!-- Plugin open content -->
                    <StackPanel x:Name="PluginOpenPanel" Grid.Row="2"
                                Margin="0,4,0,0"/>

                    <!-- Expanded Command Center & Agent Hub -->
                    <panels:ExpandedCommandCenterView x:Name="CommandCenterPanel"
                                                      Grid.Row="3"
                                                      Visibility="Collapsed"
                                                      MaxHeight="340"
                                                      Margin="0,6,0,0"/>

                    <!-- Inline settings (hidden by default, shown when gear clicked) - slides down in top mode -->
                    <views:InlineSettingsView x:Name="InlineSettings"
                                              Grid.Row="4"
                                              Visibility="Collapsed"
                                              MaxHeight="232"
                                              Margin="0,6,0,0"/>
                </Grid>

                <!-- In-Notch Floating Alert Toast (shown when operating mode changes while Notch is open) -->
                <Border x:Name="OpenOperatingModeToast"
                        Opacity="0" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Height="26" CornerRadius="13"
                        Background="#EE141416" BorderBrush="#30FFFFFF" BorderThickness="0.8"
                        Padding="10,0" Margin="0,4,0,0"
                        RenderTransformOrigin="0.5,0.5"
                        Cursor="Hand" MouseLeftButtonUp="OnOperatingModeCapsuleClick"
                        ToolTip="Click to open Power &amp; Performance settings">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="OpenOperatingModeScale" ScaleX="0.92" ScaleY="0.92"/>
                            <TranslateTransform x:Name="OpenOperatingModeTranslate" Y="-6"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="OpenOperatingModeIcon" Text="⚡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OpenOperatingModeTitle" Text="PERFORMANCE MODE" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Width="1" Height="9" Background="{DynamicResource SeparatorBrush}" Margin="6,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OpenOperatingModeSub" Text="Balanced Boost" FontSize="8.2"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Vertical closed content (side dock) -->
                <StackPanel x:Name="VerticalClosedContent" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel x:Name="VerticalPluginClosedPanel"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,8"/>
                    <TextBlock x:Name="SideTimeSmall" Text="12:00"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                    <!-- Vertical HUD Overlay for volume/brightness -->
                    <views:HudOverlay x:Name="VerticalHudOverlay"
                                      HorizontalAlignment="Center"
                                      Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Vertical open content (side dock) - expands to the right when settings opened -->
                <Grid x:Name="VerticalOpenContent" Opacity="0" Visibility="Collapsed"
                      ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/> <!-- Main vertical panel - fixed width -->
                        <ColumnDefinition Width="Auto"/>    <!-- Settings panel (visibility-controlled) -->
                    </Grid.ColumnDefinitions>

                    <!-- Main vertical content -->
                    <StackPanel Grid.Column="0" Margin="4,8,4,8" Width="152">
                        <!-- Clock -->
                        <TextBlock x:Name="SideTimeText" Text="12:00"
                                   FontSize="28" FontWeight="Light"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SideDateText" Text="ven. 18"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,14"/>

                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="6,0,6,14"/>

                        <!-- Music -->
                        <StackPanel x:Name="SideMusicPanel" HorizontalAlignment="Center">
                            <Border Width="100" Height="100" CornerRadius="12"
                                    ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,8"
                                    Background="{DynamicResource SegmentedBgBrush}">
                                <Image x:Name="SideAlbumArt" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock x:Name="SideSongTitle" Text=""
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="130"/>
                            <TextBlock x:Name="SideArtistName" Text=""
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="130"
                                       Margin="0,2,0,6"/>

                            <!-- Progress bar -->
                            <Grid Margin="0,0,0,2" Width="130">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SideElapsedText" Grid.Column="0"
                                           Text="0:00" FontSize="9"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Border Grid.Column="1" Height="3" CornerRadius="1.5"
                                        Background="{DynamicResource ProgressTrackBrush}"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OnSideProgressBarClick">
                                    <Border x:Name="SideProgressFill" Height="3" CornerRadius="1.5"
                                            Background="{DynamicResource ProgressFillBrush}"
                                            HorizontalAlignment="Left"/>
                                </Border>
                                <TextBlock x:Name="SideDurationText" Grid.Column="2"
                                           Text="0:00" FontSize="9"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>

                            <!-- Audio visualizer -->
                            <comp:AudioVisualizer x:Name="SideVisualizer"
                                                  Width="80" Height="24"
                                                  BarCount="5" BarWidth="3" BarGap="2"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,4,0,6"/>

                            <!-- Play controls -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Click="OnSidePrevClick"
                                        Style="{StaticResource IconButton}" Width="28" Height="28">
                                    <TextBlock Text="⏮" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Click="OnSidePlayClick"
                                        Style="{StaticResource IconButton}" Width="32" Height="32"
                                        Margin="12,0">
                                    <TextBlock x:Name="SidePlayIcon" Text="▶" FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </Button>
                                <Button Click="OnSideNextClick"
                                        Style="{StaticResource IconButton}" Width="28" Height="28">
                                    <TextBlock Text="⏭" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="VerticalPluginOpenPanel"
                                    Margin="0,14,0,0"/>

                        <!-- Bottom -->
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}"
                                Margin="6,14,6,10"/>

                        <Button Click="OnSideSettingsClick"
                                Style="{StaticResource IconButton}"
                                Width="24" Height="24"
                                HorizontalAlignment="Center" ToolTip="Settings"
                                Margin="0,0,0,8">
                            <TextBlock Text="⚙" FontSize="13"
                                       Foreground="{DynamicResource TextSubtleBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Settings panel for vertical mode (expands to the right) -->
                    <Border Grid.Column="1" x:Name="VerticalSettingsPanel"
                            Visibility="Collapsed"
                            Width="280"
                            ClipToBounds="True"
                            Background="{DynamicResource NotchFillBrush}"
                            Margin="0,8,0,8">
                        <views:InlineSettingsView x:Name="VerticalInlineSettings"
                                                  Width="264"
                                                  MaxHeight="436"
                                                  Margin="8,0,8,0"/>
                    </Border>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</Window>
