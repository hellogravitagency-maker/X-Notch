<UserControl x:Class="XNotch.Views.MusicLiveActivity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:XNotch.Views.Components">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <!-- Compact closed layout (Apple Dynamic Island idle pill state) -->
        <Grid x:Name="CompactLayout" Visibility="Visible" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Album art with refined squircle corners and subtle specular edge -->
            <Border Grid.Column="0" Width="20" Height="20" CornerRadius="5.5"
                    ClipToBounds="True" Margin="0,0,7,0"
                    BorderThickness="1" BorderBrush="#25FFFFFF">
                <Image x:Name="CompactAlbumArt"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Song title / lyrics with clean Apple typography -->
            <TextBlock x:Name="CompactTitle"
                       Grid.Column="1"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center"
                       Padding="0,1,0,0"
                       Margin="0,0,6,0"/>

            <!-- Apple Music dancing waveform visualizer -->
            <comp:AudioVisualizer x:Name="CompactVisualizer"
                                  Grid.Column="2"
                                  Width="22" Height="16"
                                  BarCount="4"
                                  BarWidth="3"
                                  BarGap="2"
                                  VerticalAlignment="Center"
                                  Margin="0,0,2,0"/>
        </Grid>

        <!-- Interactive Peek Capsule layout (Apple Dynamic Island hover state with micro transport) -->
        <Grid x:Name="PeekLayout" Visibility="Collapsed" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Album art with accent border glow -->
            <Border Grid.Column="0" x:Name="PeekArtBorder" Width="26" Height="26" CornerRadius="6.5"
                    ClipToBounds="True" Margin="0,0,8,0" BorderThickness="1.2"
                    BorderBrush="{DynamicResource SeparatorBrush}">
                <Image x:Name="PeekAlbumArt"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Song Title + Artist Stack -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="PeekTitle"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"/>
                <TextBlock x:Name="PeekArtist"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="9"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Margin="0,1,0,0"/>
            </StackPanel>

            <!-- Mini Previous Button -->
            <Button x:Name="MiniPrevButton"
                    Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    Width="22" Height="22"
                    Click="OnMiniPrevClick"
                    ToolTip="Previous Track"
                    Margin="0,0,2,0">
                <TextBlock Text="⏮"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>

            <!-- Mini Play/Pause Button -->
            <Button x:Name="MiniPlayButton"
                    Grid.Column="3"
                    Style="{StaticResource IconButton}"
                    Width="24" Height="24"
                    Click="OnMiniPlayClick"
                    ToolTip="Play / Pause"
                    Margin="0,0,2,0">
                <TextBlock x:Name="MiniPlayIcon"
                           Text="▶"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>

            <!-- Mini Next Button -->
            <Button x:Name="MiniNextButton"
                    Grid.Column="4"
                    Style="{StaticResource IconButton}"
                    Width="22" Height="22"
                    Click="OnMiniNextClick"
                    ToolTip="Next Track"
                    Margin="0,0,6,0">
                <TextBlock Text="⏭"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>

            <!-- Audio visualizer in peek capsule -->
            <comp:AudioVisualizer x:Name="PeekVisualizer"
                                  Grid.Column="5"
                                  Width="22" Height="16"
                                  BarCount="4"
                                  BarWidth="3"
                                  BarGap="2"
                                  VerticalAlignment="Center"
                                  Margin="0,0,2,0"/>
        </Grid>
    </Grid>
</UserControl>
