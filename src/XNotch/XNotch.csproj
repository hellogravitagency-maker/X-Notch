<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>XNotch</RootNamespace>
    <AssemblyName>X-Notch</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- App metadata -->
    <ApplicationIcon>Assets\Icons\XNotch.ico</ApplicationIcon>
    <Version>0.7.0</Version>
    <FileVersion>0.7.0.0</FileVersion>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <Product>X-Notch</Product>
    <Description>X-Notch — Intelligent Dynamic Island for Windows by Gravit</Description>
    <Company>Gravit</Company>
    <Authors>Gravit</Authors>
    <Copyright>Copyright © Gravit. All rights reserved.</Copyright>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Publish settings (applied only via: dotnet publish -c Release) -->
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
    <EmbeddedResource Include="Assets\example-library.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XNotch.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
    <PackageReference Include="NAudio" Version="2.2.*" />
    <PackageReference Include="System.Management" Version="10.0.6" />
  </ItemGroup>

</Project>
