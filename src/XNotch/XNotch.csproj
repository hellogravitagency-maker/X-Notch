<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>XNotch</RootNamespace>
    <AssemblyName>X-Notch</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- App metadata -->
    <ApplicationIcon>Assets\Icons\XNotch.ico</ApplicationIcon>
    <Version>0.9.0</Version>
    <FileVersion>0.9.0.0</FileVersion>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <Product>X-Notch</Product>
    <Description>X-Notch — Intelligent Dynamic Island for Windows by Gravit</Description>
    <Company>Gravit</Company>
    <Authors>Gravit</Authors>
    <Copyright>Copyright © Gravit. All rights reserved.</Copyright>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;WFAC010</NoWarn>

    <!-- Publish settings (applied only via: dotnet publish -c Release) -->
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" Exclude="Assets\BundledPlugins\**\*;Assets\Deck\**\*;Assets\Localization\**\*" />
    <EmbeddedResource Include="Assets\example-library.json" />
    <EmbeddedResource Include="Assets\Deck\index.html" LogicalName="XNotch.Deck.index.html" />
    <!-- WithCulture=false: "strings.es.json" would otherwise be compiled into an es\ satellite assembly -->
    <EmbeddedResource Include="Assets\Localization\*.json" LogicalName="XNotch.Localization.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Assets\BundledPlugins\*.dll" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XNotch.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
    <PackageReference Include="NAudio" Version="2.2.*" />
    <PackageReference Include="System.Management" Version="10.0.6" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.*" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel for the Phone Deck LAN server (binds without URL ACL / admin) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
